---
import Layout from '../layouts/Layout.astro';

const packages = [
  {
    type: 'New Business',
    items: ['Business cards', 'Brochures', 'Website setup', 'Signage'],
  },
  {
    type: 'Existing Business',
    items: ['Promotional products', 'Marketing kits', 'Vehicle wraps'],
  },
  {
    type: 'Restaurants',
    items: ['Fliers', 'Indoor & outdoor signs', 'Light boxes'],
  },
  {
    type: 'Retail',
    items: ['Point-of-purchase displays', 'Marketing kits', 'Folding cartons'],
  },
];

const faqs = [
  {
    q: 'What does Alexander Display & Packaging do?',
    a: 'We provide a complete range of marketing products and packaging for businesses — vehicle wraps, banners, signs, point-of-purchase displays, folding cartons, marketing kits, protective packaging, wall murals, window graphics, and canvas/PVC printing. We also offer graphic design, 3D rendering, and fulfillment services.',
  },
  {
    q: 'Where are you located and who do you serve?',
    a: 'We are based in Houston, TX at 5902 Sovereign Dr., Unit A, Suite A05. We serve businesses throughout Houston, the greater Texas area, and ship nationally.',
  },
  {
    q: 'How long have you been in business?',
    a: 'Alexander Display & Packaging was founded in Houston in 2007. We have over 17 years of experience delivering marketing products and packaging solutions.',
  },
  {
    q: 'Do you handle design, or do I need to provide files?',
    a: 'Both options work. Our in-house graphic design team can create logos, layouts, and print-ready artwork from scratch. If you already have design files, we can work directly from those.',
  },
  {
    q: "Can I see what my display or packaging will look like before it is produced?",
    a: 'Yes. We offer 3D rendering services so you can visualize your display, packaging, or signage before production begins — no surprises when your order arrives.',
  },
  {
    q: 'How do I get a quote?',
    a: 'Fill out the quote form on our website or call us at (281) 686-8602. We respond within one business day with a tailored solution for your project.',
  },
  {
    q: 'Do you offer vehicle wraps in Houston?',
    a: 'Yes. We provide full vehicle wraps, partial wraps, fleet graphics, and decals for cars, vans, trucks, and trailers. We handle design, print, and installation.',
  },
];
---

<Layout
  title="About Us | Houston Marketing Products Company Since 2007"
  description="Alexander Display & Packaging has been Houston's trusted one-stop marketing partner since 2007. Learn about our history, capabilities, and commitment to our customers."
>

  <!-- Hero -->
  <section class="pt-16 relative overflow-hidden" style="background: linear-gradient(135deg, #2d5200 0%, #4a8200 45%, #7BBD00 100%);">
    <div class="absolute -top-24 -right-24 w-[500px] h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(180,255,60,0.15) 0%, transparent 65%);"></div>
    <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px); background-size: 44px 44px;"></div>
    <svg class="absolute -bottom-8 -right-8 w-72 h-72 opacity-[0.08] pointer-events-none" viewBox="0 0 300 300" fill="none">
      <circle cx="300" cy="300" r="230" stroke="white" stroke-width="36"/>
      <circle cx="300" cy="300" r="155" stroke="white" stroke-width="24"/>
      <circle cx="300" cy="300" r="78" stroke="white" stroke-width="14"/>
    </svg>
    <div class="max-w-6xl mx-auto px-6 py-24 relative z-10">
      <p class="text-sm font-bold uppercase tracking-widest text-white/70 mb-5">About Us</p>
      <h1 class="text-5xl md:text-6xl font-black text-white leading-tight max-w-3xl mb-6">
        An Industry Leader Since 2007
      </h1>
      <p class="text-white/80 text-xl max-w-2xl leading-relaxed">
        Built on commitment to service, quality, and a customer-first philosophy — we've grown from a local Houston shop to a full-service marketing powerhouse.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-4">Our Story</p>
        <h2 class="text-3xl font-black text-neutral-900 mb-6">From Houston to Everywhere You Need to Be</h2>
        <div class="space-y-4 text-neutral-600 leading-relaxed">
          <p>
            Founded in 2007, Alexander Display & Packaging was built on a simple belief: businesses shouldn't have to juggle multiple vendors to get their marketing done. We set out to be the single partner that handles everything — from concept and design to production and fulfillment.
          </p>
          <p>
            Over the years, we've grown into an industry leader with a diverse range of products and services. Our commitment to service and our customer-focused philosophy have earned us long-term partnerships with businesses of all sizes — from startups to established brands.
          </p>
          <p>
            Based in Houston, TX, we serve clients across the country with fast turnaround times, competitive pricing, and quality that speaks for itself.
          </p>
        </div>
      </div>
      <div class="space-y-5">
        <div class="bg-brand-light rounded-xl p-8 border border-brand/20">
          <p class="text-sm font-bold uppercase tracking-widest text-brand mb-3">Our Mission</p>
          <p class="text-neutral-700 leading-relaxed">
            To be the complete one stop solution for our clients' marketing needs — providing both the strategy and the materials to help every business grow.
          </p>
        </div>
        <div class="bg-neutral-900 rounded-xl p-8">
          <p class="text-sm font-bold uppercase tracking-widest text-brand mb-4">Our Approach</p>
          <ul class="space-y-3 text-sm text-neutral-300">
            {[
              'We don\'t just consult — we deliver the materials',
              'Customized packages for every type of business',
              'Fast turnaround, no shortcuts on quality',
              'Long-term partnerships, not one-off transactions',
            ].map(item => (
              <li class="flex items-start gap-3">
                <span class="mt-1 w-4 h-4 rounded-full bg-brand shrink-0 flex items-center justify-center">
                  <svg width="8" height="8" fill="white" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Package solutions -->
  <section class="py-24 px-6 bg-brand-light">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-3">Tailored For You</p>
        <h2 class="text-4xl font-black text-neutral-900">Marketing Packages for Every Business</h2>
        <p class="text-neutral-500 mt-4 max-w-xl mx-auto">
          We build custom marketing packages that combine consulting with the physical materials you need to reach your goal.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {packages.map(({ type, items }) => (
          <div class="bg-white rounded-xl p-7 shadow-sm border border-brand/10">
            <div class="w-8 h-1 bg-brand rounded-full mb-4"></div>
            <h3 class="font-black text-neutral-900 mb-4">{type}</h3>
            <ul class="space-y-2">
              {items.map(item => (
                <li class="text-sm text-neutral-500 flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Materials -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-brand mb-4">Materials & Capabilities</p>
          <h2 class="text-3xl font-black text-neutral-900 mb-6">Built with the Right Materials</h2>
          <p class="text-neutral-600 leading-relaxed mb-6">
            We work with a wide range of substrates and materials to ensure every product performs as well as it looks — whether it's going in a retail store, on a trade show floor, or wrapping a vehicle.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Corrugated Board', 'Chipboard', 'Foamcore', 'Sintra PVC', 'Acrylic', 'Wood', 'Metal', 'Specialty Foam'].map(m => (
              <span class="px-3 py-1.5 bg-brand-light text-brand-darker text-xs font-bold rounded-full border border-brand/20">
                {m}
              </span>
            ))}
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          {[
            { label: 'Printing Services', desc: 'Business cards, brochures, banners, canvas, murals, window graphics, and more.' },
            { label: 'Creative Services', desc: '3D rendering, graphic design, structural prototyping, and assembly instructions.' },
            { label: 'Display Products', desc: 'Vehicle wraps, POP displays, folding cartons, marketing kits, and packaging.' },
            { label: 'Fulfillment', desc: 'Storage, kitting, and distribution handled by our team so you can focus on selling.' },
          ].map(({ label, desc }) => (
            <div class="bg-neutral-50 rounded-xl p-5 border border-neutral-200">
              <p class="font-bold text-neutral-900 text-sm mb-2">{label}</p>
              <p class="text-neutral-500 text-xs leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-3">FAQ</p>
        <h2 class="text-4xl font-black text-neutral-900">Common Questions</h2>
        <p class="text-neutral-500 mt-4 max-w-xl mx-auto">Everything you need to know about working with us.</p>
      </div>
      <div class="divide-y divide-neutral-100">
        {faqs.map(({ q, a }) => (
          <details class="group py-6 cursor-pointer list-none">
            <summary class="flex items-center justify-between gap-4 font-black text-neutral-900 text-lg select-none list-none">
              {q}
              <span class="shrink-0 w-7 h-7 rounded-full border-2 border-neutral-200 flex items-center justify-center group-open:border-brand group-open:bg-brand transition-colors">
                <svg class="w-3 h-3 text-neutral-400 group-open:text-white transition-colors rotate-0 group-open:rotate-45 duration-200" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-neutral-500 leading-relaxed text-sm max-w-3xl">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6 relative overflow-hidden" style="background: linear-gradient(135deg, #2d5200 0%, #4a8200 45%, #7BBD00 100%);">
    <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px); background-size: 44px 44px;"></div>
    <div class="max-w-3xl mx-auto text-center relative z-10">
      <h2 class="text-3xl font-black text-white mb-5">Let's Build Something Together</h2>
      <p class="text-white/80 mb-8 text-lg">
        We build long-term partnerships with our customers. Reach out and let's start yours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="px-8 py-4 bg-white text-brand font-bold rounded-md hover:bg-brand-light transition-colors text-sm uppercase tracking-wide">
          Contact Us
        </a>
        <a href="tel:2816868602" class="px-8 py-4 border-2 border-white/50 text-white font-bold rounded-md hover:border-white transition-colors text-sm uppercase tracking-wide">
          (281) 686-8602
        </a>
      </div>
    </div>
  </section>

</Layout>

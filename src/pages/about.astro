---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="Learn about Alexander Display — our history, values, and the team behind your projects.">
  <!-- Hero -->
  <section class="pt-32 pb-16 px-6 bg-neutral-50">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm font-medium uppercase tracking-widest text-neutral-500 mb-4">About Us</p>
      <h1 class="text-5xl md:text-6xl font-bold text-neutral-900 leading-tight max-w-3xl">
        A legacy of craftsmanship in display
      </h1>
    </div>
  </section>

  <!-- Story -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="text-3xl font-bold text-neutral-900 mb-6">Our Story</h2>
        <div class="space-y-4 text-neutral-600 leading-relaxed">
          <p>
            Alexander Display was founded on the belief that great physical presence matters. In a world increasingly saturated with digital noise, the right display can cut through the clutter and create a genuine moment of connection between a brand and its audience.
          </p>
          <p>
            For over two decades, we've partnered with retailers, exhibitors, and businesses of every size — from independent boutiques to national chains — to develop display solutions that are both beautifully designed and built to last.
          </p>
          <p>
            We operate our own production facility, which means we control quality at every step: from design and material selection through fabrication and finishing.
          </p>
        </div>
      </div>
      <div class="space-y-8">
        <div class="p-8 bg-neutral-50 rounded-lg">
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Our Mission</h3>
          <p class="text-neutral-600 text-sm leading-relaxed">
            To create display experiences that amplify our clients' brands — with precision, craft, and an obsessive attention to detail.
          </p>
        </div>
        <div class="p-8 bg-neutral-50 rounded-lg">
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Our Values</h3>
          <ul class="text-neutral-600 text-sm leading-relaxed space-y-2">
            <li>Craftsmanship over shortcuts</li>
            <li>Transparent communication at every stage</li>
            <li>Sustainable materials where possible</li>
            <li>Solutions built to the brief, not sold off the shelf</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-24 px-6 bg-neutral-50">
    <div class="max-w-6xl mx-auto">
      <div class="mb-14">
        <p class="text-sm font-medium uppercase tracking-widest text-neutral-500 mb-3">The Team</p>
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900">The people behind your project</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        {[
          { name: 'James Alexander', role: 'Founder & Creative Director' },
          { name: 'Maria Chen', role: 'Head of Production' },
          { name: 'Derek Ross', role: 'Lead Designer' },
        ].map(({ name, role }) => (
          <div class="bg-white p-8 rounded-lg border border-neutral-200">
            <div class="w-14 h-14 bg-neutral-200 rounded-full mb-5" />
            <p class="font-semibold text-neutral-900">{name}</p>
            <p class="text-sm text-neutral-500 mt-1">{role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-neutral-900 mb-5">Let's work together</h2>
      <p class="text-neutral-600 mb-10 max-w-lg mx-auto">
        We'd love to hear about your next project. Reach out and we'll get back to you within one business day.
      </p>
      <a href="/contact" class="px-8 py-4 bg-neutral-900 text-white rounded-md font-medium hover:bg-neutral-700 transition-colors">
        Get in Touch
      </a>
    </div>
  </section>
</Layout>

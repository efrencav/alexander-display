---
import Layout from '../layouts/Layout.astro';
import InstagramCarousel from '../components/InstagramCarousel.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What products and services does Alexander Display & Packaging offer?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Alexander Display & Packaging offers vehicle wraps, banners and signs, point-of-purchase displays, folding cartons, marketing kits, protective packaging, wall murals, window graphics, canvas and PVC printing, graphic design, 3D rendering, and fulfillment services.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is Alexander Display & Packaging located?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Alexander Display & Packaging is located at 5902 Sovereign Dr., Unit A, Suite A05, Houston, TX 77036. We serve businesses throughout Houston and the greater Texas area.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long has Alexander Display & Packaging been in business?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Alexander Display & Packaging was founded in Houston, TX in 2007. We have over 17 years of experience providing marketing products and packaging solutions.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you offer vehicle wraps in Houston, TX?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Alexander Display & Packaging provides full vehicle wraps, partial wraps, fleet graphics, and decals in Houston, TX. We handle design, print, and installation.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I get a free quote from Alexander Display & Packaging?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. You can request a free quote online at alexanderdisplay.com or by calling (281) 686-8602. We respond within one business day.',
      },
    },
  ],
};

const heroImages = [
  { src: '/hero/feather-flag.png',          label: 'Feather Flags',          href: '/products#banners-signs' },
  { src: '/hero/retractable-banner.png',     label: 'Retractable Banners',    href: '/products#banners-signs' },
  { src: '/hero/tradeshow-display.png',      label: 'Trade Show Displays',    href: '/products#pop-displays',  imgClass: 'max-h-[680px]' },
  { src: '/hero/folding-carton.png',         label: 'Folding Cartons',        href: '/products#folding-cartons' },
  { src: '/hero/vehicle-wrap.png',           label: 'Vehicle Wraps',          href: '/products#vehicle-wraps' },
  { src: '/hero/floor-display.png',          label: 'Floor Displays',         href: '/products#pop-displays' },
];

const products = [
  { name: 'Vehicle Wraps',               icon: '🚗', href: '/products#vehicle-wraps',       desc: 'Full and partial wraps that turn your fleet into moving billboards.' },
  { name: 'Banners & Signs',             icon: '🪧', href: '/products#banners-signs',        desc: 'Indoor and outdoor banners, yard signs, and large-format prints.' },
  { name: 'Point of Purchase Displays',  icon: '🏪', href: '/products#pop-displays',         desc: 'Retail displays engineered to increase sales at the moment of decision.' },
  { name: 'Folding Cartons',             icon: '📦', href: '/products#folding-cartons',      desc: 'Custom packaging that protects your product and elevates your brand.' },
  { name: 'Marketing Kits',              icon: '🎯', href: '/products#marketing-kits',       desc: 'Complete, branded kits combining print and promotional materials.' },
  { name: 'Protective Packaging',        icon: '🛡️', href: '/products#protective-packaging', desc: 'Foam, corrugated, and specialty packaging for fragile or high-value products.' },
  { name: 'Wall Murals & Window Graphics', icon: '🖼️', href: '/products#wall-murals',       desc: 'Transform your space with custom wall graphics and perforated window film.' },
  { name: 'Canvas & PVC Printing',       icon: '🎨', href: '/products#canvas-pvc',           desc: 'High-resolution canvas prints and PVC banners for any environment.' },
];
---

<Layout
  title="Home"
  description="Alexander Display & Packaging — Houston's one-stop shop for vehicle wraps, banners, POP displays, custom packaging, and marketing materials since 2007."
  schema={faqSchema}
>

  <!-- ═══════════════════════════════════════════════
       HERO — scroll-driven image sequence (desktop)
       Mobile: static hero with image grid
  ════════════════════════════════════════════════ -->

  <!-- Scroll driver: 6 images × 100vh each = tall enough to cycle through all -->
  <div id="hero-driver" class="relative hidden lg:block" style={`height: calc(${heroImages.length} * 100vh)`}>

    <!-- Sticky panel — pins to viewport while driver scrolls past -->
    <div class="sticky top-0 h-screen overflow-hidden" style="background: linear-gradient(135deg, #2d5200 0%, #4a8200 45%, #7BBD00 100%);">

      <!-- Background layers -->
      <div class="absolute -top-32 -right-32 w-[700px] h-[700px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(180,255,60,0.18) 0%, transparent 65%);"></div>
      <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px); background-size: 44px 44px;"></div>
      <svg class="absolute -bottom-8 -right-8 w-[420px] h-[420px] opacity-[0.09] pointer-events-none" viewBox="0 0 300 300" fill="none">
        <circle cx="300" cy="300" r="230" stroke="white" stroke-width="36"/>
        <circle cx="300" cy="300" r="155" stroke="white" stroke-width="24"/>
        <circle cx="300" cy="300" r="78" stroke="white" stroke-width="14"/>
      </svg>

      <!-- Content grid -->
      <div class="h-full flex items-center pt-[35px] pb-8 relative z-10">
        <div class="w-full max-w-6xl mx-auto px-6">
          <div class="grid grid-cols-[1fr_480px] gap-16 items-center">

            <!-- Left: copy (static throughout) -->
            <div>
              <p class="inline-block text-sm font-bold uppercase tracking-widest text-white/70 mb-6 bg-white/10 px-3 py-1 rounded-full">
                Founded 2007 · Houston, TX
              </p>
              <h1 class="text-4xl xl:text-6xl font-black text-white leading-tight mb-6">
                The Complete<br />
                <span class="relative inline-block pb-3">
                  One Stop Solution
                  <svg class="absolute left-0 -bottom-1 w-full overflow-visible" viewBox="0 0 420 14" fill="none" aria-hidden="true">
                    <path d="M4 9 C60 3, 120 13, 190 7 C250 2, 320 12, 416 6" stroke="#BDD67C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                  </svg>
                </span><br />
                <span class="text-white/90">for Your Marketing Needs</span>
              </h1>
              <p class="text-xl text-white/80 leading-relaxed mb-8 max-w-xl">
                From vehicle wraps to trade show displays, packaging to signage — Alexander Display & Packaging delivers everything your brand needs under one roof.
              </p>
              <div class="flex flex-wrap gap-4 mb-10">
                <a href="/products" class="px-6 py-3 border-2 border-white/50 text-white font-bold rounded-md hover:border-white transition-colors text-sm uppercase tracking-wide">
                  View Our Products
                </a>
                <a href="/contact#contact-form" class="px-6 py-3 bg-white text-brand font-bold rounded-md hover:bg-brand-light transition-colors text-sm uppercase tracking-wide">
                  Get a Free Quote
                </a>
              </div>
              <p class="text-white/70 text-sm font-medium">
                Call us today: <a href="tel:2816868602" class="text-white hover:underline font-bold">(281) 686-8602</a>
              </p>
            </div>

            <!-- Right: scroll-driven image sequence -->
            <div class="relative h-[520px] flex items-center">

              <!-- Image slides (all stacked, opacity toggled by scroll) -->
              <div class="relative w-full h-full" id="hero-img-stack">
                {heroImages.map(({ src, label, href, imgClass }, i) => (
                  <a
                    href={href}
                    data-hero-slide={i}
                    class="absolute inset-0 flex flex-col items-center justify-center gap-5 transition-opacity duration-500 pointer-events-none"
                    style={i === 0 ? 'opacity:1' : 'opacity:0'}
                    tabindex="-1"
                    aria-hidden={i !== 0}
                  >
                    <img
                      src={src}
                      alt={label}
                      class={`${imgClass ?? 'max-h-[504px]'} w-auto object-contain drop-shadow-2xl select-none`}
                      draggable="false"
                    />
                    <span class="text-xs font-black uppercase tracking-[0.2em] text-white/50 bg-white/10 px-4 py-1.5 rounded-full">
                      {label}
                    </span>
                  </a>
                ))}
              </div>

              <!-- Progress dots -->
              <div class="absolute -right-8 top-1/2 -translate-y-1/2 flex flex-col gap-3">
                {heroImages.map((_, i) => (
                  <div
                    data-hero-dot={i}
                    class="w-1.5 rounded-full bg-[#BDD67C] transition-all duration-300"
                    style={i === 0 ? 'height:20px;opacity:1' : 'height:6px;opacity:0.3'}
                  ></div>
                ))}
              </div>

            </div>

          </div>
        </div>
      </div>

      <!-- Scroll hint — fades out after first scroll -->
      <div id="scroll-hint" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 transition-opacity duration-500 pointer-events-none z-20">
        <span class="text-white/50 text-xs font-bold uppercase tracking-widest">Scroll to explore</span>
        <svg class="w-4 h-4 text-white/40 animate-bounce" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>

    </div><!-- /sticky -->
  </div><!-- /hero-driver -->


  <!-- Mobile hero (shown only on < lg) -->
  <section class="lg:hidden pt-16 relative overflow-hidden" style="background: linear-gradient(135deg, #2d5200 0%, #4a8200 45%, #7BBD00 100%);">
    <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px); background-size: 44px 44px;"></div>
    <div class="max-w-6xl mx-auto px-6 py-16 relative z-10">
      <p class="inline-block text-sm font-bold uppercase tracking-widest text-white/70 mb-6 bg-white/10 px-3 py-1 rounded-full">
        Founded 2007 · Houston, TX
      </p>
      <h1 class="text-4xl font-black text-white leading-tight mb-6">
        The Complete<br />
        <span class="relative inline-block pb-3">
          One Stop Solution
          <svg class="absolute left-0 -bottom-1 w-full overflow-visible" viewBox="0 0 420 14" fill="none" aria-hidden="true">
            <path d="M4 9 C60 3, 120 13, 190 7 C250 2, 320 12, 416 6" stroke="#BDD67C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span><br />
        <span class="text-white/90">for Your Marketing Needs</span>
      </h1>
      <p class="text-lg text-white/80 leading-relaxed mb-8">
        From vehicle wraps to trade show displays, packaging to signage — everything your brand needs under one roof.
      </p>
      <div class="flex flex-wrap gap-4 mb-10">
        <a href="/products" class="px-6 py-3 border-2 border-white/50 text-white font-bold rounded-md hover:border-white transition-colors text-sm uppercase tracking-wide">
          View Products
        </a>
        <a href="/contact#contact-form" class="px-6 py-3 bg-white text-brand font-bold rounded-md text-sm uppercase tracking-wide">
          Get a Quote
        </a>
      </div>
      <!-- Small image grid on mobile -->
      <div class="grid grid-cols-3 gap-3 pb-10">
        {heroImages.map(({ src, label }) => (
          <div class="bg-white/10 rounded-xl p-3 flex flex-col items-center gap-2">
            <img src={src} alt={label} class="h-20 w-auto object-contain" />
            <span class="text-white/60 text-[10px] font-bold uppercase tracking-wide text-center leading-tight">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Products Grid -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-3">What We Offer</p>
        <h2 class="text-4xl font-black text-neutral-900">Everything You Need to Stand Out</h2>
        <p class="text-neutral-500 mt-4 max-w-xl mx-auto">
          Billboards, vehicle wraps, packaging, signage, promotional products and more — all in one place.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {products.map(({ name, icon, desc, href }) => (
          <a href={href} class="group p-6 border border-neutral-200 rounded-xl hover:border-brand hover:shadow-lg transition-all">
            <div class="text-3xl mb-3">{icon}</div>
            <h3 class="font-bold text-neutral-900 mb-2 group-hover:text-brand transition-colors">{name}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{desc}</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/products" class="inline-flex items-center gap-2 text-brand font-bold hover:text-brand-dark transition-colors">
          View all products & services
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <InstagramCarousel />

  <!-- Why Alexander Display -->
  <section class="py-24 px-6 relative overflow-hidden" style="background: linear-gradient(135deg, #ffffff 0%, #f2fae0 55%, #e6f7c0 100%);">
    <div class="absolute -top-20 -right-20 w-[460px] h-[460px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(123,189,0,0.10) 0%, transparent 68%);"></div>
    <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle, rgba(123,189,0,0.18) 1px, transparent 1px); background-size: 26px 26px; opacity: 0.35;"></div>
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center relative z-10">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-4">Why Choose Us</p>
        <h2 class="text-4xl font-black text-neutral-900 mb-6">An Industry Leader Since 2007</h2>
        <p class="text-neutral-600 leading-relaxed mb-5">
          Alexander Display & Packaging has grown to become an industry leader with a commitment to service and a customer-focused philosophy. We don't stop at consulting — we provide the materials you need to reach your goal.
        </p>
        <p class="text-neutral-600 leading-relaxed mb-8">
          From new businesses to established brands, restaurants to retailers — we build tailored marketing packages that combine strategy with execution.
        </p>
        <a href="/about" class="inline-flex items-center gap-2 px-6 py-3 bg-brand text-white font-bold rounded-md hover:bg-brand-dark transition-colors text-sm">
          Learn About Us
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-5">
        {[
          { stat: '2007', label: 'Year Founded' },
          { stat: '8+', label: 'Product Categories' },
          { stat: '1', label: 'Stop for All Marketing' },
          { stat: 'HTX', label: 'Houston, Texas Based' },
        ].map(({ stat, label }) => (
          <div class="bg-white rounded-xl p-7 shadow-sm border border-brand/20">
            <p class="text-4xl font-black text-brand mb-1">{stat}</p>
            <p class="text-sm text-neutral-500 font-medium">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Strip -->
  <section class="py-20 px-6 bg-neutral-900">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-3">Our Services</p>
        <h2 class="text-4xl font-black text-white">More Than Just Printing</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { title: 'Graphic Design', desc: 'Professional design that makes your brand shine.' },
          { title: '3D Rendering', desc: 'Visualize your display or packaging before production.' },
          { title: 'Fulfillment Services', desc: 'We handle storage, kitting, and distribution.' },
          { title: 'Assembly Instructions', desc: 'Clear, branded documentation for complex displays.' },
        ].map(({ title, desc }) => (
          <div class="p-6 border border-neutral-700 rounded-xl hover:border-brand transition-colors">
            <div class="w-8 h-1 bg-brand rounded-full mb-4"></div>
            <h3 class="font-bold text-white mb-2">{title}</h3>
            <p class="text-neutral-400 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl font-black text-neutral-900 mb-5">Ready to Grow Your Brand?</h2>
      <p class="text-neutral-500 mb-10 text-lg leading-relaxed">
        Tell us about your project. We'll put together a complete marketing solution — no obligation, fast turnaround.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact#contact-form" class="px-8 py-4 bg-brand text-white font-bold rounded-md hover:bg-brand-dark transition-colors text-sm uppercase tracking-wide">
          Get a Free Quote
        </a>
        <a href="tel:2816868602" class="px-8 py-4 border-2 border-neutral-200 text-neutral-700 font-bold rounded-md hover:border-brand hover:text-brand transition-colors text-sm uppercase tracking-wide">
          Call (281) 686-8602
        </a>
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  const driver = document.getElementById('hero-driver');
  if (driver) {
    const slides = document.querySelectorAll('[data-hero-slide]');
    const dots   = document.querySelectorAll('[data-hero-dot]');
    const hint   = document.getElementById('scroll-hint');
    const count  = slides.length;
    let hintHidden = false;

    function update() {
      const rect       = driver.getBoundingClientRect();
      const totalScroll = driver.offsetHeight - window.innerHeight;
      const scrolled   = -rect.top;
      const progress   = Math.max(0, Math.min(1, scrolled / totalScroll));
      const index      = Math.min(Math.floor(progress * count), count - 1);

      slides.forEach((s, i) => {
        s.style.opacity       = i === index ? '1' : '0';
        s.style.pointerEvents = i === index ? 'auto' : 'none';
        s.setAttribute('aria-hidden', i !== index ? 'true' : 'false');
      });

      dots.forEach((d, i) => {
        d.style.opacity   = i === index ? '1'  : '0.3';
        d.style.height    = i === index ? '20px' : '6px';
      });

      if (!hintHidden && scrolled > 20) {
        hint.style.opacity = '0';
        hintHidden = true;
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

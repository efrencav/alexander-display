---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    category: 'Retail',
    items: [
      {
        title: 'Point-of-Purchase Displays',
        desc: 'Countertop and floor-standing displays designed to drive impulse purchase and reinforce your brand message at the moment of decision.',
      },
      {
        title: 'Gondola & Shelving Systems',
        desc: 'Custom and modular shelving solutions for retail environments, built for durability and easy reconfiguration.',
      },
      {
        title: 'Window & Endcap Displays',
        desc: 'High-impact showcase displays that maximize visibility in high-traffic retail zones.',
      },
    ],
  },
  {
    category: 'Trade Show & Events',
    items: [
      {
        title: 'Custom Exhibit Booths',
        desc: 'Fully bespoke exhibit environments designed to stand out on the show floor and represent your brand at its best.',
      },
      {
        title: 'Modular Exhibit Systems',
        desc: 'Reusable, reconfigurable display systems that adapt to different booth sizes and event types.',
      },
      {
        title: 'Branded Environments',
        desc: 'Full-room branded environments for corporate events, product launches, and experiential activations.',
      },
    ],
  },
  {
    category: 'Signage & Environmental',
    items: [
      {
        title: 'Interior Signage',
        desc: 'Dimensional letters, lobby signs, and branded wall treatments that make an immediate impression.',
      },
      {
        title: 'Exterior Signage',
        desc: 'Weather-resistant exterior signage built to attract attention and endure the elements.',
      },
      {
        title: 'Wayfinding Systems',
        desc: 'Cohesive directional signage that guides visitors through your space with clarity and brand consistency.',
      },
    ],
  },
];
---

<Layout title="Services" description="Explore Alexander Display's full range of display and signage services.">
  <!-- Hero -->
  <section class="pt-32 pb-16 px-6 bg-neutral-50">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm font-medium uppercase tracking-widest text-neutral-500 mb-4">Services</p>
      <h1 class="text-5xl md:text-6xl font-bold text-neutral-900 leading-tight max-w-3xl">
        Everything you need to stand out
      </h1>
    </div>
  </section>

  <!-- Services list -->
  {services.map(({ category, items }) => (
    <section class="py-16 px-6 border-b border-neutral-100 last:border-0">
      <div class="max-w-6xl mx-auto">
        <p class="text-sm font-medium uppercase tracking-widest text-neutral-500 mb-10">{category}</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {items.map(({ title, desc }) => (
            <div class="p-8 border border-neutral-200 rounded-lg hover:border-neutral-400 transition-colors">
              <h3 class="text-lg font-semibold text-neutral-900 mb-3">{title}</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Process -->
  <section class="py-24 px-6 bg-neutral-900 text-white">
    <div class="max-w-6xl mx-auto">
      <div class="mb-14">
        <p class="text-sm font-medium uppercase tracking-widest text-neutral-400 mb-3">How It Works</p>
        <h2 class="text-3xl md:text-4xl font-bold">Our process</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
        {[
          { step: '01', title: 'Discovery', desc: 'We learn about your brand, goals, and project constraints.' },
          { step: '02', title: 'Design', desc: 'Our team develops concepts and renders for your approval.' },
          { step: '03', title: 'Production', desc: 'We fabricate your display in our own facility with close quality control.' },
          { step: '04', title: 'Delivery', desc: 'We handle logistics and, where needed, on-site installation.' },
        ].map(({ step, title, desc }) => (
          <div>
            <p class="text-4xl font-bold text-neutral-700 mb-4">{step}</p>
            <h3 class="text-lg font-semibold text-white mb-2">{title}</h3>
            <p class="text-neutral-400 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-neutral-900 mb-5">Not sure what you need?</h2>
      <p class="text-neutral-600 mb-10 max-w-lg mx-auto">
        Tell us about your project and we'll recommend the right solution — with no obligation.
      </p>
      <a href="/contact" class="px-8 py-4 bg-neutral-900 text-white rounded-md font-medium hover:bg-neutral-700 transition-colors">
        Start a Conversation
      </a>
    </div>
  </section>
</Layout>

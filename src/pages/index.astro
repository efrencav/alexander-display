---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Alexander Display — Custom displays and visual solutions for businesses.">
  <!-- Hero -->
  <section class="pt-32 pb-24 px-6 bg-neutral-50">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-widest text-neutral-500 mb-4">Display Solutions</p>
        <h1 class="text-5xl md:text-6xl font-bold text-neutral-900 leading-tight mb-6">
          Visual presence that commands attention
        </h1>
        <p class="text-xl text-neutral-600 leading-relaxed mb-10 max-w-2xl">
          Alexander Display crafts custom display solutions — from retail fixtures to trade show exhibits — that communicate your brand with clarity and impact.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/services" class="px-6 py-3 bg-neutral-900 text-white rounded-md font-medium hover:bg-neutral-700 transition-colors">
            Explore Services
          </a>
          <a href="/contact" class="px-6 py-3 border border-neutral-300 text-neutral-900 rounded-md font-medium hover:border-neutral-900 transition-colors">
            Start a Project
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services overview -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="mb-14">
        <p class="text-sm font-medium uppercase tracking-widest text-neutral-500 mb-3">What We Do</p>
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900">Display solutions for every need</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            title: 'Retail Displays',
            desc: 'Point-of-purchase fixtures and in-store displays designed to drive conversions and reinforce brand identity.',
          },
          {
            title: 'Trade Show Exhibits',
            desc: 'Modular and custom booth designs that maximize impact in competitive exhibition environments.',
          },
          {
            title: 'Signage & Wayfinding',
            desc: 'Interior and exterior signage systems that guide, inform, and leave a lasting impression.',
          },
        ].map(({ title, desc }) => (
          <div class="p-8 border border-neutral-200 rounded-lg hover:border-neutral-400 transition-colors">
            <h3 class="text-lg font-semibold text-neutral-900 mb-3">{title}</h3>
            <p class="text-neutral-600 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="/services" class="text-sm font-medium text-neutral-900 underline underline-offset-4 hover:text-neutral-600 transition-colors">
          View all services
        </a>
      </div>
    </div>
  </section>

  <!-- Why Alexander Display -->
  <section class="py-24 px-6 bg-neutral-900 text-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-sm font-medium uppercase tracking-widest text-neutral-400 mb-4">Why Us</p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Built on craftsmanship and collaboration</h2>
          <p class="text-neutral-300 leading-relaxed mb-6">
            We combine decades of manufacturing expertise with a design-first approach, ensuring every display we produce is both functionally sound and visually striking.
          </p>
          <a href="/about" class="inline-flex items-center text-sm font-medium text-white underline underline-offset-4 hover:text-neutral-300 transition-colors">
            Learn about us
          </a>
        </div>
        <div class="grid grid-cols-2 gap-6">
          {[
            { stat: '20+', label: 'Years of experience' },
            { stat: '500+', label: 'Projects delivered' },
            { stat: '100%', label: 'Custom solutions' },
            { stat: '48h', label: 'Avg. quote turnaround' },
          ].map(({ stat, label }) => (
            <div class="p-6 bg-neutral-800 rounded-lg">
              <p class="text-3xl font-bold text-white mb-1">{stat}</p>
              <p class="text-sm text-neutral-400">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-5">Ready to build something remarkable?</h2>
      <p class="text-neutral-600 mb-10 max-w-xl mx-auto">
        Tell us about your project and we'll put together a tailored proposal — no obligation.
      </p>
      <a href="/contact" class="px-8 py-4 bg-neutral-900 text-white rounded-md font-medium hover:bg-neutral-700 transition-colors">
        Get a Free Quote
      </a>
    </div>
  </section>
</Layout>

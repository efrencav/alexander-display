---
import Layout from '../layouts/Layout.astro';
import InstagramCarousel from '../components/InstagramCarousel.astro';

const products = [
  { name: 'Vehicle Wraps',               icon: '🚗', href: '/products#vehicle-wraps',       desc: 'Full and partial wraps that turn your fleet into moving billboards.' },
  { name: 'Banners & Signs',             icon: '🪧', href: '/products#banners-signs',        desc: 'Indoor and outdoor banners, yard signs, and large-format prints.' },
  { name: 'Point of Purchase Displays',  icon: '🏪', href: '/products#pop-displays',         desc: 'Retail displays engineered to increase sales at the moment of decision.' },
  { name: 'Folding Cartons',             icon: '📦', href: '/products#folding-cartons',      desc: 'Custom packaging that protects your product and elevates your brand.' },
  { name: 'Marketing Kits',              icon: '🎯', href: '/products#marketing-kits',       desc: 'Complete, branded kits combining print and promotional materials.' },
  { name: 'Protective Packaging',        icon: '🛡️', href: '/products#protective-packaging', desc: 'Foam, corrugated, and specialty packaging for fragile or high-value products.' },
  { name: 'Wall Murals & Window Graphics', icon: '🖼️', href: '/products#wall-murals',       desc: 'Transform your space with custom wall graphics and perforated window film.' },
  { name: 'Canvas & PVC Printing',       icon: '🎨', href: '/products#canvas-pvc',           desc: 'High-resolution canvas prints and PVC banners for any environment.' },
];
---

<Layout title="Home" description="Alexander Display & Packaging — The complete one stop solution for your marketing needs. Houston, TX.">

  <!-- Hero -->
  <section class="pt-16 min-h-[90vh] flex items-center relative overflow-hidden">
    <!-- Gradient base -->
    <div class="absolute inset-0" style="background: linear-gradient(135deg, #2d5200 0%, #4a8200 45%, #7BBD00 100%);"></div>
    <!-- Soft glow top-right -->
    <div class="absolute -top-32 -right-32 w-[700px] h-[700px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(180,255,60,0.18) 0%, transparent 65%);"></div>
    <!-- Grid texture -->
    <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px); background-size: 44px 44px;"></div>
    <!-- Decorative concentric arcs bottom-right -->
    <svg class="absolute -bottom-8 -right-8 w-[420px] h-[420px] opacity-[0.09] pointer-events-none" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="300" cy="300" r="230" stroke="white" stroke-width="36"/>
      <circle cx="300" cy="300" r="155" stroke="white" stroke-width="24"/>
      <circle cx="300" cy="300" r="78" stroke="white" stroke-width="14"/>
    </svg>

    <div class="w-full max-w-6xl mx-auto px-6 py-24 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-12 xl:gap-20 items-center">

        <!-- Copy -->
        <div>
          <p class="inline-block text-sm font-bold uppercase tracking-widest text-white/70 mb-6 bg-white/10 px-3 py-1 rounded-full">
            Founded 2007 · Houston, TX
          </p>
          <h1 class="text-4xl md:text-6xl font-black text-white leading-tight mb-6">
            The Complete<br />
            <span class="relative inline-block pb-3">
              One Stop Solution
              <svg class="absolute left-0 -bottom-1 w-full overflow-visible" viewBox="0 0 420 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 9 C60 3, 120 13, 190 7 C250 2, 320 12, 416 6" stroke="#BDD67C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </span><br />
            <span class="text-white/90">for Your Marketing Needs</span>
          </h1>
          <p class="text-xl text-white/80 leading-relaxed mb-8 max-w-xl">
            From vehicle wraps to trade show displays, packaging to signage — Alexander Display & Packaging delivers everything your brand needs under one roof.
          </p>
          <div class="flex flex-wrap gap-4 mb-10">
            <a href="/products" class="px-6 py-3 border-2 border-white/50 text-white font-bold rounded-md hover:border-white transition-colors text-sm uppercase tracking-wide">
              View Our Products
            </a>
          </div>
          <p class="text-white/70 text-sm font-medium">
            Call us today: <a href="tel:2816868602" class="text-white hover:underline font-bold">(281) 686-8602</a>
          </p>
        </div>

        <!-- Quote form card -->
        <div class="bg-white rounded-2xl shadow-2xl p-7 lg:p-8">
          <p class="text-xs font-bold uppercase tracking-widest text-brand mb-1">Free Quote</p>
          <h2 class="text-xl font-black text-neutral-900 mb-6">Tell us about your project</h2>
          <form name="hero-quote" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you" class="space-y-4">
            <input type="hidden" name="form-name" value="hero-quote" />
            <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="hero-first" class="block text-xs font-semibold text-neutral-600 mb-1.5">First Name</label>
                <input id="hero-first" name="first-name" type="text" required autocomplete="given-name"
                  class="w-full px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"
                  placeholder="Jane" />
              </div>
              <div>
                <label for="hero-last" class="block text-xs font-semibold text-neutral-600 mb-1.5">Last Name</label>
                <input id="hero-last" name="last-name" type="text" required autocomplete="family-name"
                  class="w-full px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"
                  placeholder="Smith" />
              </div>
            </div>
            <div>
              <label for="hero-email" class="block text-xs font-semibold text-neutral-600 mb-1.5">Email</label>
              <input id="hero-email" name="email" type="email" required autocomplete="email"
                class="w-full px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"
                placeholder="jane@company.com" />
            </div>
            <div>
              <label for="hero-phone" class="block text-xs font-semibold text-neutral-600 mb-1.5">Phone</label>
              <input id="hero-phone" name="phone" type="tel" autocomplete="tel"
                class="w-full px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"
                placeholder="(555) 000-0000" />
            </div>
            <div>
              <label for="hero-service" class="block text-xs font-semibold text-neutral-600 mb-1.5">I'm interested in…</label>
              <select id="hero-service" name="service"
                class="w-full px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors bg-white text-neutral-700">
                <option value="">Select a service...</option>
                <option value="vehicle-wraps">Vehicle Wraps</option>
                <option value="banners-signs">Banners & Signs</option>
                <option value="pop-displays">Point of Purchase Displays</option>
                <option value="folding-cartons">Folding Cartons</option>
                <option value="marketing-kits">Marketing Kits</option>
                <option value="protective-packaging">Protective Packaging</option>
                <option value="wall-murals">Wall Murals & Window Graphics</option>
                <option value="canvas-pvc">Canvas & PVC Printing</option>
                <option value="graphic-design">Graphic Design</option>
                <option value="other">Other / Not Sure</option>
              </select>
            </div>
            <button type="submit"
              class="w-full px-6 py-3.5 bg-brand text-white font-bold rounded-lg hover:bg-brand-dark transition-colors text-sm uppercase tracking-wide">
              Get My Free Quote →
            </button>
            <p class="text-center text-xs text-neutral-400">
              Need more detail? <a href="/contact" class="text-brand font-semibold hover:underline">Send a full message</a>
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-3">What We Offer</p>
        <h2 class="text-4xl font-black text-neutral-900">Everything You Need to Stand Out</h2>
        <p class="text-neutral-500 mt-4 max-w-xl mx-auto">
          Billboards, vehicle wraps, packaging, signage, promotional products and more — all in one place.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {products.map(({ name, icon, desc, href }) => (
          <a href={href} class="group p-6 border border-neutral-200 rounded-xl hover:border-brand hover:shadow-lg transition-all">
            <div class="text-3xl mb-3">{icon}</div>
            <h3 class="font-bold text-neutral-900 mb-2 group-hover:text-brand transition-colors">{name}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{desc}</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/products" class="inline-flex items-center gap-2 text-brand font-bold hover:text-brand-dark transition-colors">
          View all products & services
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <InstagramCarousel />

  <!-- Why Alexander Display -->
  <section class="py-24 px-6 relative overflow-hidden" style="background: linear-gradient(135deg, #ffffff 0%, #f2fae0 55%, #e6f7c0 100%);">
    <!-- Soft glow top-right -->
    <div class="absolute -top-20 -right-20 w-[460px] h-[460px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(123,189,0,0.10) 0%, transparent 68%);"></div>
    <!-- Dot pattern -->
    <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle, rgba(123,189,0,0.18) 1px, transparent 1px); background-size: 26px 26px; opacity: 0.35;"></div>
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center relative z-10">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-4">Why Choose Us</p>
        <h2 class="text-4xl font-black text-neutral-900 mb-6">
          An Industry Leader Since 2007
        </h2>
        <p class="text-neutral-600 leading-relaxed mb-5">
          Alexander Display & Packaging has grown to become an industry leader with a commitment to service and a customer-focused philosophy. We don't stop at consulting — we provide the materials you need to reach your goal.
        </p>
        <p class="text-neutral-600 leading-relaxed mb-8">
          From new businesses to established brands, restaurants to retailers — we build tailored marketing packages that combine strategy with execution.
        </p>
        <a href="/about" class="inline-flex items-center gap-2 px-6 py-3 bg-brand text-white font-bold rounded-md hover:bg-brand-dark transition-colors text-sm">
          Learn About Us
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-5">
        {[
          { stat: '2007', label: 'Year Founded' },
          { stat: '8+', label: 'Product Categories' },
          { stat: '1', label: 'Stop for All Marketing' },
          { stat: 'HTX', label: 'Houston, Texas Based' },
        ].map(({ stat, label }) => (
          <div class="bg-white rounded-xl p-7 shadow-sm border border-brand/20">
            <p class="text-4xl font-black text-brand mb-1">{stat}</p>
            <p class="text-sm text-neutral-500 font-medium">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Strip -->
  <section class="py-20 px-6 bg-neutral-900">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-3">Our Services</p>
        <h2 class="text-4xl font-black text-white">More Than Just Printing</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { title: 'Graphic Design', desc: 'Professional design that makes your brand shine.' },
          { title: '3D Rendering', desc: 'Visualize your display or packaging before production.' },
          { title: 'Fulfillment Services', desc: 'We handle storage, kitting, and distribution.' },
          { title: 'Assembly Instructions', desc: 'Clear, branded documentation for complex displays.' },
        ].map(({ title, desc }) => (
          <div class="p-6 border border-neutral-700 rounded-xl hover:border-brand transition-colors">
            <div class="w-8 h-1 bg-brand rounded-full mb-4"></div>
            <h3 class="font-bold text-white mb-2">{title}</h3>
            <p class="text-neutral-400 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl font-black text-neutral-900 mb-5">
        Ready to Grow Your Brand?
      </h2>
      <p class="text-neutral-500 mb-10 text-lg leading-relaxed">
        Tell us about your project. We'll put together a complete marketing solution — no obligation, fast turnaround.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="px-8 py-4 bg-brand text-white font-bold rounded-md hover:bg-brand-dark transition-colors text-sm uppercase tracking-wide">
          Get a Free Quote
        </a>
        <a href="tel:2816868602" class="px-8 py-4 border-2 border-neutral-200 text-neutral-700 font-bold rounded-md hover:border-brand hover:text-brand transition-colors text-sm uppercase tracking-wide">
          Call (281) 686-8602
        </a>
      </div>
    </div>
  </section>

</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us" description="Contact Alexander Display & Packaging in Houston, TX. Call (281) 686-8602 or send us a message.">

  <!-- Hero -->
  <section class="pt-16 relative overflow-hidden" style="background: linear-gradient(135deg, #2d5200 0%, #4a8200 45%, #7BBD00 100%);">
    <!-- Soft glow -->
    <div class="absolute -top-24 -right-24 w-[500px] h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(180,255,60,0.15) 0%, transparent 65%);"></div>
    <!-- Grid texture -->
    <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px); background-size: 44px 44px;"></div>
    <!-- Decorative arcs -->
    <svg class="absolute -bottom-8 -right-8 w-72 h-72 opacity-[0.08] pointer-events-none" viewBox="0 0 300 300" fill="none">
      <circle cx="300" cy="300" r="230" stroke="white" stroke-width="36"/>
      <circle cx="300" cy="300" r="155" stroke="white" stroke-width="24"/>
      <circle cx="300" cy="300" r="78" stroke="white" stroke-width="14"/>
    </svg>
    <div class="max-w-6xl mx-auto px-6 py-24 relative z-10">
      <p class="text-sm font-bold uppercase tracking-widest text-white/70 mb-5">Contact Us</p>
      <h1 class="text-5xl md:text-6xl font-black text-white leading-tight max-w-3xl mb-6">
        Let's Get Started
      </h1>
      <p class="text-white/80 text-xl max-w-xl leading-relaxed">
        We build long-term partnerships with our customers. Reach out and let's talk about your project.
      </p>
    </div>
  </section>

  <!-- Contact content -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-5 gap-16">

      <!-- Info panel -->
      <div class="md:col-span-2 space-y-8">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-brand mb-5">Get In Touch</p>
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-brand-light flex items-center justify-center shrink-0">
                <svg width="18" height="18" fill="currentColor" class="text-brand" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-1">Phone</p>
                <a href="tel:2816868602" class="text-neutral-900 font-semibold hover:text-brand transition-colors">(281) 686-8602</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-brand-light flex items-center justify-center shrink-0">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="text-brand" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 2.07 4.18 2 2 0 0 1 4.05 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-1">Fax</p>
                <p class="text-neutral-700">(281) 558-8777</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-brand-light flex items-center justify-center shrink-0">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="text-brand" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-1">Address</p>
                <p class="text-neutral-700 leading-relaxed">
                  5902 Sovereign Dr., Unit A<br />
                  Suite A05<br />
                  Houston, TX 77036
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-brand-light rounded-xl p-6 border border-brand/20">
          <p class="font-black text-neutral-900 mb-2">We build long-term partnerships</p>
          <p class="text-neutral-600 text-sm leading-relaxed">
            Send us a message and we'll follow up promptly to discuss your project and put together a tailored solution.
          </p>
        </div>

        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-4">Follow Us</p>
          <div class="flex gap-3">
            <a href="https://facebook.com/alexanderdisplay/" target="_blank" rel="noopener"
              class="flex items-center gap-2 px-4 py-2 border border-neutral-200 rounded-lg text-sm font-semibold text-neutral-700 hover:border-brand hover:text-brand transition-colors">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              Facebook
            </a>
            <a href="https://instagram.com/alexanderdisplay/" target="_blank" rel="noopener"
              class="flex items-center gap-2 px-4 py-2 border border-neutral-200 rounded-lg text-sm font-semibold text-neutral-700 hover:border-brand hover:text-brand transition-colors">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              Instagram
            </a>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="md:col-span-3">
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-6">Send a Message</p>
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you" class="space-y-5">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="first-name" class="block text-sm font-semibold text-neutral-700 mb-2">First Name</label>
              <input id="first-name" name="first-name" type="text" required autocomplete="given-name"
                class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"
                placeholder="Jane" />
            </div>
            <div>
              <label for="last-name" class="block text-sm font-semibold text-neutral-700 mb-2">Last Name</label>
              <input id="last-name" name="last-name" type="text" required autocomplete="family-name"
                class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"
                placeholder="Smith" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-neutral-700 mb-2">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email"
              class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"
              placeholder="jane@company.com" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-semibold text-neutral-700 mb-2">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel"
              class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"
              placeholder="(555) 000-0000" />
          </div>
          <div>
            <label for="service" class="block text-sm font-semibold text-neutral-700 mb-2">What are you interested in?</label>
            <select id="service" name="service"
              class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors bg-white text-neutral-700">
              <option value="">Select a product or service...</option>
              <option value="vehicle-wraps">Vehicle Wraps</option>
              <option value="banners-signs">Banners & Signs</option>
              <option value="pop-displays">Point of Purchase Displays</option>
              <option value="folding-cartons">Folding Cartons</option>
              <option value="marketing-kits">Marketing Kits</option>
              <option value="protective-packaging">Protective Packaging</option>
              <option value="wall-murals">Wall Murals & Window Graphics</option>
              <option value="canvas-pvc">Canvas & PVC Printing</option>
              <option value="graphic-design">Graphic Design</option>
              <option value="other">Other / Not Sure</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-semibold text-neutral-700 mb-2">Message</label>
            <textarea id="message" name="message" rows="5" required
              class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors resize-none"
              placeholder="Tell us about your project — timeline, quantity, or anything else that helps us understand what you need."></textarea>
          </div>
          <button type="submit"
            class="w-full px-6 py-4 bg-brand text-white font-bold rounded-lg hover:bg-brand-dark transition-colors text-sm uppercase tracking-wide">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>

</Layout>

---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-sm border-b border-neutral-100">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-semibold tracking-tight text-neutral-900">
      Alexander Display
    </a>
    <ul class="hidden md:flex items-center gap-8">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`text-sm font-medium transition-colors hover:text-neutral-900 ${
              currentPath === href ? 'text-neutral-900' : 'text-neutral-500'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/contact"
      class="hidden md:inline-flex items-center px-4 py-2 text-sm font-medium bg-neutral-900 text-white rounded-md hover:bg-neutral-700 transition-colors"
    >
      Get in Touch
    </a>
    <!-- Mobile menu button -->
    <button
      id="menu-btn"
      class="md:hidden p-2 text-neutral-600"
      aria-label="Toggle menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-100 bg-white">
    <ul class="px-6 py-4 space-y-3">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class="block text-sm font-medium text-neutral-700 hover:text-neutral-900">
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a href="/contact" class="block text-sm font-medium text-center px-4 py-2 bg-neutral-900 text-white rounded-md">
          Get in Touch
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>

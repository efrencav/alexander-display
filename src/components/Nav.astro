---
const currentPath = Astro.url.pathname;

const simpleLinks = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact Us' },
];

const featuredProducts = [
  {
    num: '01',
    href: '/products#vehicle-wraps',
    title: 'Vehicle Wraps',
    desc: 'Turn your fleet into moving billboards. Full wraps, partial wraps, and fleet graphics.',
  },
  {
    num: '02',
    href: '/products#pop-displays',
    title: 'Point of Purchase Displays',
    desc: 'Drive conversions at the moment of decision with retail-ready floor and countertop displays.',
  },
  {
    num: '03',
    href: '/products#folding-cartons',
    title: 'Folding Cartons & Packaging',
    desc: 'Custom packaging that protects your product and communicates your brand on shelf.',
  },
];

const moreProducts = [
  { label: 'Banners & Signs',             href: '/products#banners-signs' },
  { label: 'Marketing Kits',              href: '/products#marketing-kits' },
  { label: 'Wall Murals & Window Graphics', href: '/products#wall-murals' },
  { label: 'Protective Packaging',        href: '/products#protective-packaging' },
  { label: 'Canvas & PVC Printing',       href: '/products#canvas-pvc' },
  { label: 'Graphic Design',              href: '/products#services' },
  { label: '3D Rendering',               href: '/products#services' },
  { label: 'Fulfillment Services',        href: '/products#services' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-neutral-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between py-3">

    <!-- Logo -->
    <a href="/" class="shrink-0">
      <img src="/logo.svg" alt="Alexander Display & Packaging" class="h-20 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-7">

      <!-- Products trigger -->
      <div class="relative" id="products-trigger-wrap">
        <button
          id="products-trigger"
          class="flex items-center gap-1 text-sm font-medium text-neutral-600 hover:text-brand transition-colors"
          aria-expanded="false"
          aria-haspopup="true"
        >
          Products & Services
          <svg id="products-chevron" class="w-3 h-3 opacity-50 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>

      <!-- Simple links -->
      {simpleLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`text-sm font-medium transition-colors hover:text-brand ${currentPath === href ? 'text-brand' : 'text-neutral-600'}`}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <a
      href="/contact#contact-form"
      class="hidden md:inline-flex items-center gap-2 bg-brand text-white text-sm font-bold px-5 py-2.5 rounded-full hover:bg-brand-dark transition-colors"
    >
      Get a Quote
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>

    <!-- Hamburger (mobile) -->
    <button id="mobile-menu-btn" class="md:hidden p-2 -mr-2" aria-label="Toggle menu" aria-expanded="false">
      <svg id="icon-open" class="w-6 h-6 text-neutral-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 text-neutral-700 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- ── Products Mega Menu Panel ── -->
  <div
    id="mega-products"
    class="absolute top-full left-0 right-0 bg-white border-t border-neutral-100 shadow-xl opacity-0 invisible -translate-y-2 transition-all duration-200 ease-out z-50"
    role="region"
    aria-label="Products menu"
  >
    <div class="max-w-6xl mx-auto px-6 py-10">
      <div class="grid grid-cols-4 gap-6">

        <!-- Intro column -->
        <div class="flex flex-col justify-between pr-6 border-r border-neutral-100">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-brand mb-3">Our Products & Services</p>
            <h3 class="text-lg font-black text-neutral-900 leading-snug mb-3">Everything under<br>one roof.</h3>
            <p class="text-sm text-neutral-500 leading-relaxed">
              From vehicle wraps to folding cartons — we handle design, production, and fulfillment.
            </p>
          </div>
          <a href="/products" class="inline-flex items-center gap-2 text-sm font-bold text-neutral-900 hover:text-brand transition-colors mt-8 group/all">
            View all products
            <svg class="w-4 h-4 transition-transform group-hover/all:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Product cards -->
        {featuredProducts.map(({ num, href, title, desc }) => (
          <a
            href={href}
            class="group/card flex flex-col p-5 rounded-xl border border-transparent hover:border-neutral-100 hover:bg-brand-light transition-all duration-150"
          >
            <span class="text-[11px] font-black text-brand tracking-widest mb-3">{num}</span>
            <h4 class="text-base font-black text-neutral-900 mb-2 group-hover/card:text-brand transition-colors">
              {title}
            </h4>
            <p class="text-sm text-neutral-500 leading-relaxed flex-1">{desc}</p>
            <span class="inline-flex items-center gap-1 text-xs font-bold text-neutral-400 group-hover/card:text-brand transition-colors mt-5">
              Learn more
              <svg class="w-3 h-3 transition-transform group-hover/card:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Bottom strip -->
      <div class="mt-8 pt-6 border-t border-neutral-100 flex flex-wrap items-center gap-x-1 gap-y-2">
        <span class="text-xs text-neutral-400 mr-2">Also:</span>
        {moreProducts.map(({ label, href }, i) => (
          <span class="inline-flex items-center">
            <a href={href} class="text-xs font-semibold text-neutral-600 hover:text-brand transition-colors">{label}</a>
            {i < moreProducts.length - 1 && <span class="text-neutral-300 mx-2">·</span>}
          </span>
        ))}
        <a href="/contact#contact-form" class="ml-4 text-xs font-bold text-brand hover:text-brand-dark transition-colors">
          Don't see what you need? Ask us →
        </a>
      </div>
    </div>
  </div>

  <!-- ── Mobile Menu ── -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-neutral-100 bg-white overflow-hidden"
  >
    <div class="px-6 py-5 space-y-1">

      <!-- Products accordion -->
      <div>
        <button
          id="mobile-products-btn"
          class="w-full flex items-center justify-between py-3 text-sm font-semibold text-neutral-700 hover:text-brand transition-colors"
        >
          Products & Services
          <svg id="mobile-products-chevron" class="w-4 h-4 opacity-50 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-products-sub" class="hidden pl-3 pb-2 space-y-1 border-l-2 border-brand">
          {featuredProducts.map(({ href, title }) => (
            <a href={href} class="block py-2 text-sm text-neutral-600 hover:text-brand transition-colors">{title}</a>
          ))}
          {moreProducts.map(({ label, href }) => (
            <a href={href} class="block py-2 text-sm text-neutral-600 hover:text-brand transition-colors">{label}</a>
          ))}
          <a href="/products" class="block py-2 text-sm font-bold text-brand">View all →</a>
        </div>
      </div>

      {simpleLinks.map(({ href, label }) => (
        <a href={href} class="block py-3 text-sm font-semibold text-neutral-700 hover:text-brand transition-colors border-t border-neutral-50">
          {label}
        </a>
      ))}

      <div class="pt-4">
        <a href="/contact#contact-form" class="flex items-center justify-center gap-2 w-full py-3 bg-brand text-white text-sm font-bold rounded-full hover:bg-brand-dark transition-colors">
          Get a Quote
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // ── Mega menu ──
  const trigger = document.getElementById('products-trigger') as HTMLButtonElement;
  const chevron = document.getElementById('products-chevron') as HTMLElement;
  const mega = document.getElementById('mega-products') as HTMLElement;
  const wrap = document.getElementById('products-trigger-wrap') as HTMLElement;

  let closeTimer: ReturnType<typeof setTimeout> | null = null;

  function openMega() {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    mega.classList.remove('opacity-0', 'invisible', '-translate-y-2');
    mega.classList.add('opacity-100', 'visible', 'translate-y-0');
    chevron.classList.add('rotate-180');
    trigger.setAttribute('aria-expanded', 'true');
  }

  function closeMega() {
    mega.classList.add('opacity-0', 'invisible', '-translate-y-2');
    mega.classList.remove('opacity-100', 'visible', 'translate-y-0');
    chevron.classList.remove('rotate-180');
    trigger.setAttribute('aria-expanded', 'false');
  }

  function scheduleClose() {
    closeTimer = setTimeout(closeMega, 120);
  }

  // Hover on trigger
  wrap.addEventListener('mouseenter', openMega);
  wrap.addEventListener('mouseleave', scheduleClose);

  // Hover on mega panel
  mega.addEventListener('mouseenter', () => {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
  });
  mega.addEventListener('mouseleave', scheduleClose);

  // Click trigger (for keyboard/tap users)
  trigger.addEventListener('click', () => {
    const isOpen = trigger.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMega() : openMega();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMega();
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!wrap.contains(e.target as Node) && !mega.contains(e.target as Node)) {
      closeMega();
    }
  });

  // ── Mobile menu ──
  const mobileBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
  const iconOpen = document.getElementById('icon-open') as HTMLElement;
  const iconClose = document.getElementById('icon-close') as HTMLElement;

  mobileBtn.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
    mobileBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // ── Mobile products accordion ──
  const mobileProductsBtn = document.getElementById('mobile-products-btn') as HTMLButtonElement;
  const mobileProductsSub = document.getElementById('mobile-products-sub') as HTMLElement;
  const mobileProductsChevron = document.getElementById('mobile-products-chevron') as HTMLElement;

  mobileProductsBtn.addEventListener('click', () => {
    const isOpen = mobileProductsSub.classList.toggle('hidden');
    mobileProductsChevron.classList.toggle('rotate-180', !isOpen);
  });
</script>

---
// Most recent posts from @alexanderdisplay — update shortcodes to swap posts
const posts = [
  'DCiWNfUieqj',
  'DCKBM6lM6Wy',
  'DC68Sr1MloD',
  'DCF8Q3yNWtK',
  'DC1ytuKs4w1',
  'DC0Ls8DKAew',
  'DByvPP_IdWt',
  'DBwSHJiBDff',
  'DBr3xEiJXLK',
  'DBRSb8kNsyX',
];
---

<section class="py-24 bg-neutral-950 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 mb-12">
    <div class="flex items-end justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-brand mb-3">Our Work</p>
        <h2 class="text-4xl font-black text-white">Latest from Instagram</h2>
        <p class="text-neutral-400 mt-3">
          Follow us
          <a href="https://instagram.com/alexanderdisplay/" target="_blank" rel="noopener"
            class="text-brand hover:text-brand-light font-bold transition-colors">@alexanderdisplay</a>
        </p>
      </div>
      <div class="hidden md:flex items-center gap-3">
        <button id="ig-prev"
          class="w-11 h-11 rounded-full border border-neutral-700 flex items-center justify-center text-neutral-400 hover:border-brand hover:text-brand transition-colors"
          aria-label="Previous">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button id="ig-next"
          class="w-11 h-11 rounded-full border border-neutral-700 flex items-center justify-center text-neutral-400 hover:border-brand hover:text-brand transition-colors"
          aria-label="Next">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Embla viewport -->
  <div id="ig-embla" class="overflow-hidden">
    <div id="ig-container" class="flex gap-4 pl-6" style="max-width: calc(var(--vw, 100vw));">
      {posts.map((shortcode) => (
        <div class="ig-slide shrink-0 w-[320px] rounded-xl overflow-hidden bg-neutral-900 border border-neutral-800">
          <!-- Placeholder shown while embed loads -->
          <div class="ig-placeholder aspect-square flex flex-col items-center justify-center bg-neutral-900 border-b border-neutral-800 text-neutral-600 text-sm gap-3">
            <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="opacity-30">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            <span class="opacity-30">Loading post…</span>
          </div>
          <div class="p-3 flex items-center justify-between">
            <span class="text-xs text-neutral-500 font-medium">@alexanderdisplay</span>
            <a href={`https://www.instagram.com/p/${shortcode}/`} target="_blank" rel="noopener"
              class="text-xs font-bold text-brand hover:text-brand-light transition-colors flex items-center gap-1">
              View
              <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Dot indicators -->
  <div class="flex justify-center gap-2 mt-8" id="ig-dots">
    {posts.map((_, i) => (
      <button
        class={`ig-dot w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-brand w-6' : 'bg-neutral-700 hover:bg-neutral-500'}`}
        data-index={i}
        aria-label={`Go to slide ${i + 1}`}
      />
    ))}
  </div>

  <!-- Mobile arrows -->
  <div class="flex justify-center gap-3 mt-6 md:hidden">
    <button id="ig-prev-mobile"
      class="w-11 h-11 rounded-full border border-neutral-700 flex items-center justify-center text-neutral-400 hover:border-brand hover:text-brand transition-colors"
      aria-label="Previous">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
    <button id="ig-next-mobile"
      class="w-11 h-11 rounded-full border border-neutral-700 flex items-center justify-center text-neutral-400 hover:border-brand hover:text-brand transition-colors"
      aria-label="Next">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
  </div>
</section>

<!-- Load real Instagram images into placeholders -->
<script>
  import EmblaCarousel from 'embla-carousel';
  import type { EmblaCarouselType } from 'embla-carousel';

  // ── Embla setup ──
  const viewport = document.getElementById('ig-embla') as HTMLElement;
  const container = document.getElementById('ig-container') as HTMLElement;

  const embla: EmblaCarouselType = EmblaCarousel(viewport, {
    loop: true,
    align: 'start',
    dragFree: false,
    slidesToScroll: 1,
  });

  // Arrows
  const prevBtns = [document.getElementById('ig-prev'), document.getElementById('ig-prev-mobile')];
  const nextBtns = [document.getElementById('ig-next'), document.getElementById('ig-next-mobile')];
  prevBtns.forEach(btn => btn?.addEventListener('click', () => embla.scrollPrev()));
  nextBtns.forEach(btn => btn?.addEventListener('click', () => embla.scrollNext()));

  // Dots
  const dots = document.querySelectorAll<HTMLButtonElement>('.ig-dot');
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => embla.scrollTo(i));
  });

  function updateDots(index: number) {
    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('bg-brand', 'w-6');
        dot.classList.remove('bg-neutral-700', 'w-2');
      } else {
        dot.classList.remove('bg-brand', 'w-6');
        dot.classList.add('bg-neutral-700', 'w-2');
      }
    });
  }

  embla.on('select', () => updateDots(embla.selectedScrollSnap()));

  // Autoplay
  let autoplay = setInterval(() => embla.scrollNext(), 4000);
  viewport.addEventListener('mouseenter', () => clearInterval(autoplay));
  viewport.addEventListener('mouseleave', () => {
    autoplay = setInterval(() => embla.scrollNext(), 4000);
  });

  // ── Load Instagram images via oEmbed thumbnail ──
  const slides = document.querySelectorAll<HTMLElement>('.ig-slide');
  const shortcodes = [
    'DCiWNfUieqj','DCKBM6lM6Wy','DC68Sr1MloD','DCF8Q3yNWtK','DC1ytuKs4w1',
    'DC0Ls8DKAew','DByvPP_IdWt','DBwSHJiBDff','DBr3xEiJXLK','DBRSb8kNsyX',
  ];

  shortcodes.forEach((code, i) => {
    const slide = slides[i];
    if (!slide) return;
    const placeholder = slide.querySelector<HTMLElement>('.ig-placeholder');
    if (!placeholder) return;

    // Replace placeholder with actual Instagram embed iframe
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.instagram.com/p/${code}/embed/captioned/`;
    iframe.width = '320';
    iframe.height = '380';
    iframe.frameBorder = '0';
    iframe.scrolling = 'no';
    iframe.loading = 'lazy';
    iframe.style.cssText = 'display:block; border:none; overflow:hidden; width:100%;';
    iframe.setAttribute('allowtransparency', 'true');

    placeholder.replaceWith(iframe);
  });
</script>

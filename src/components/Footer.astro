---
const year = new Date().getFullYear();
---

<footer class="bg-neutral-900 text-neutral-400">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <img src="/logo-reversed.svg" alt="Alexander Display & Packaging" class="h-14 w-auto mb-4" />
        <p class="text-sm leading-relaxed max-w-xs">
          The complete one stop solution for your marketing needs. Founded in Houston, TX in 2007.
        </p>
        <div class="flex gap-4 mt-5">
          <a href="https://facebook.com/alexanderdisplay/" target="_blank" rel="noopener" aria-label="Facebook"
            class="w-9 h-9 rounded-full bg-neutral-800 flex items-center justify-center hover:bg-brand transition-colors">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://instagram.com/alexanderdisplay/" target="_blank" rel="noopener" aria-label="Instagram"
            class="w-9 h-9 rounded-full bg-neutral-800 flex items-center justify-center hover:bg-brand transition-colors">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>
      <div>
        <p class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">Quick Links</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-brand transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-brand transition-colors">About Us</a></li>
          <li><a href="/products" class="hover:text-brand transition-colors">Products & Services</a></li>
          <li><a href="/contact" class="hover:text-brand transition-colors">Contact Us</a></li>
        </ul>
      </div>
      <div>
        <p class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">Contact</p>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="tel:2816868602" class="hover:text-brand transition-colors flex items-start gap-2">
              <svg class="mt-0.5 shrink-0" width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
              (281) 686-8602
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 shrink-0" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>5902 Sovereign Dr., Unit A<br />Suite A05, Houston, TX 77036</span>
          </li>
        </ul>
      </div>
    </div>
    <div class="border-t border-neutral-800 mt-12 pt-8 text-sm text-center">
      &copy; {year} Alexander Display & Packaging. All rights reserved.
    </div>
  </div>
</footer>

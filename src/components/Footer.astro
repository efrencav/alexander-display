---
const year = new Date().getFullYear();
---

<footer class="bg-neutral-900 text-neutral-400">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <div>
        <p class="text-white font-semibold text-lg mb-3">Alexander Display</p>
        <p class="text-sm leading-relaxed">
          Custom display and visual solutions crafted to make your brand stand out.
        </p>
      </div>
      <div>
        <p class="text-white font-medium mb-3 text-sm uppercase tracking-widest">Navigation</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
          <li><a href="/services" class="hover:text-white transition-colors">Services</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="text-white font-medium mb-3 text-sm uppercase tracking-widest">Contact</p>
        <ul class="space-y-2 text-sm">
          <li><a href="mailto:hello@alexanderdisplay.com" class="hover:text-white transition-colors">hello@alexanderdisplay.com</a></li>
          <li><a href="tel:+15550000000" class="hover:text-white transition-colors">(555) 000-0000</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-neutral-800 mt-12 pt-8 text-sm text-center">
      &copy; {year} Alexander Display. All rights reserved.
    </div>
  </div>
</footer>
